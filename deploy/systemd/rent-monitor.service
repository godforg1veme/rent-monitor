# managed-by: rent-monitor
[Unit]
Description=Rent Monitor Telegram apartment search
After=network-online.target rent-monitor-captcha.service tailscaled.service
Wants=network-online.target rent-monitor-captcha.service
JoinsNamespaceOf=rent-monitor-captcha.service

[Service]
Type=simple
User=rent-monitor
Group=rent-monitor
WorkingDirectory=/opt/rent-monitor/current
StateDirectory=rent-monitor
StateDirectoryMode=0750
Environment=RENT_MONITOR_DATABASE=/var/lib/rent-monitor/rent-monitor.sqlite3
Environment=DISPLAY=:99
Environment=XDG_CONFIG_HOME=/var/lib/rent-monitor/browser-config
Environment=XDG_CACHE_HOME=/var/lib/rent-monitor/browser-cache
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/rent-monitor/playwright
Environment=RENT_MONITOR_CAPTCHA_TOKEN_DIRECTORY=/run/rent-monitor-captcha/tokens
EnvironmentFile=-/etc/rent-monitor/environment
Environment=PYTHONDONTWRITEBYTECODE=1
LoadCredential=telegram_bot_token:/etc/rent-monitor/telegram_bot_token
ExecStart=/opt/rent-monitor/current/.venv/bin/rent-monitor serve --config /opt/rent-monitor/current/config/search.toml
Restart=on-failure
RestartSec=15s
TimeoutStopSec=30s
UMask=0077

CPUQuota=200%
MemoryMax=4G
TasksMax=512
IOWeight=10

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/rent-monitor /run/rent-monitor-captcha

StandardOutput=journal
StandardError=journal
SyslogIdentifier=rent-monitor

[Install]
WantedBy=multi-user.target
